---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-content">
    <p class="copyright">
      &copy; {currentYear} <strong>Linacker</strong>. Built with 
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> & 
      <a href="https://pages.github.com" target="_blank" rel="noopener noreferrer">GitHub Pages</a>.
    </p>
    <p class="domain-info">
      Connected to <a href="https://linacker.dev">linacker.dev</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border-color);
    padding: 2.5rem 0;
    background-color: var(--bg-secondary);
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }

  .footer-content a {
    color: var(--accent-color);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-content a:hover {
    color: var(--accent-hover);
  }
</style>
