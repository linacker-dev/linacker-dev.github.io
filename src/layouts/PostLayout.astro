---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, tags = [] } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);

const formattedUpdatedDate = updatedDate
  ? new Intl.DateTimeFormat('ko-KR', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(updatedDate)
  : null;
---

<BaseLayout title={title} description={description}>
  <article class="container post-container">
    <div class="post-back">
      <a href="/" class="back-link">&larr; 글 목록으로 돌아가기</a>
    </div>

    <header class="post-header">
      <div class="post-meta">
        <time datetime={pubDate.toISOString()} class="post-date">{formattedDate}</time>
        {formattedUpdatedDate && (
          <span class="post-updated">(업데이트: {formattedUpdatedDate})</span>
        )}
      </div>

      <h1 class="post-title">{title}</h1>

      <p class="post-description">{description}</p>

      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <a href={`/tags/${tag}`} class="tag-badge">
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="prose post-content">
      <slot />
    </div>

    <footer class="post-footer">
      <div class="post-back">
        <a href="/" class="back-link">&larr; 글 목록으로 돌아가기</a>
      </div>
    </footer>
  </article>

  <script is:inline type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
    
    const initMermaid = async () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'neutral',
        fontFamily: 'inherit',
      });

      // Shiki or standard pre blocks with mermaid
      const codeBlocks = document.querySelectorAll('pre[data-language="mermaid"], pre code.language-mermaid, pre.mermaid, pre > code[data-language="mermaid"]');
      const uniquePres = new Set();
      codeBlocks.forEach((el) => {
        const pre = el.tagName === 'PRE' ? el : el.closest('pre');
        if (pre) uniquePres.add(pre);
      });

      let index = 0;
      for (const pre of uniquePres) {
        if (pre.dataset.processed) continue;
        pre.dataset.processed = 'true';
        const content = pre.textContent?.trim() || '';
        const container = document.createElement('div');
        container.className = 'mermaid-render-container';
        container.style.display = 'flex';
        container.style.justifyContent = 'center';
        container.style.margin = '2rem 0';
        container.style.overflowX = 'auto';

        try {
          const id = `mermaid-chart-${Date.now()}-${index++}`;
          const { svg } = await mermaid.render(id, content);
          container.innerHTML = svg;
          pre.replaceWith(container);
        } catch (err) {
          console.warn('Mermaid rendering failed:', err);
        }
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMermaid);
    } else {
      initMermaid();
    }
  </script>
</BaseLayout>

<style>
  .post-container {
    max-width: 760px;
  }

  .post-back {
    margin-bottom: 2rem;
  }

  .back-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .back-link:hover {
    color: var(--accent-color);
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .post-meta {
    display: flex;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .post-title {
    font-size: 2.4rem;
    line-height: 1.25;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .post-description {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-content {
    line-height: 1.8;
  }

  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }
</style>
